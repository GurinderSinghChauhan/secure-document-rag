# Development uses the console email sender and a development-only signing key.
# Production startup rejects these defaults.
ENVIRONMENT=development
JWT_SIGNING_KEYS_JSON={"development":"development-only-signing-key-change-before-production-1234567890"}
JWT_ACTIVE_KEY_ID=development
JWT_ISSUER=secure-document-rag
JWT_AUDIENCE=secure-document-rag-ui
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PUBLIC_APP_URL=http://localhost:8080
COOKIE_SECURE=false
EMAIL_VERIFICATION_REQUIRED=false
INVITATION_DELIVERY=manual
PASSWORD_RESET_DELIVERY=disabled
EMAIL_SENDER=console
EMAIL_FROM_ADDRESS=noreply@example.invalid
# Production email configuration:
# RESEND_API_KEY=
POSTGRES_PASSWORD=replace-with-a-unique-long-postgres-password
DATABASE_URL=postgresql+asyncpg://secure_rag:replace-with-a-unique-long-postgres-password@postgres:5432/secure_rag
QDRANT_URL=http://qdrant:6333
MODEL_SERVER_URL=http://host.docker.internal:1234/v1
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
CHAT_MODEL=qwen/qwen3-4b-2507
VISION_MODEL=qwen/qwen3-vl-4b
MINERU_ENABLED=true
MINERU_URL=http://mineru:8000
MINERU_BACKEND=pipeline
MINERU_IMAGE=mineru:3.2.1
MINERU_GPU_DEVICE=0
MINERU_TIMEOUT_SECONDS=600
MINERU_MAX_OUTPUT_BYTES=104857600
MINERU_VISUAL_ENRICHMENT_MIN_CHARACTERS=80
MAX_UPLOAD_BYTES=26214400
MAX_DOCUMENT_CHUNKS=2000
MAX_VISUALS_PER_DOCUMENT=40
VISUAL_ANALYSIS_CONCURRENCY=2
VISION_MAX_TOKENS=512
EMBEDDING_BATCH_SIZE=128
MAX_CONTEXT_CHARACTERS=24000
MIN_RETRIEVAL_SCORE=0.25
CLASSIFICATION_AUTO_ACCEPT_THRESHOLD=0.85
CLASSIFICATION_REVIEW_THRESHOLD=0.60
ALLOWED_HOSTS=localhost,127.0.0.1

# Cost-safe compute control. Uploads remain held while this is false.
GPU_DISPATCH_ENABLED=false
COMPUTE_PROVIDER=local_docker
COMPUTE_GPU_HOURLY_COST_USD=0
COMPUTE_RETRY_LIMIT=3
COMPUTE_WORKER_PROFILE=nvidia-16gb-qwen3-vl-4b-quantized
COMPUTE_FALLBACK_PROFILE=nvidia-24gb-qwen3-vl-4b-quantized
# Optional until an administrator selects Runpod and explicitly enables dispatch.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# RUNPOD_API_BASE_URL=https://api.runpod.ai/v2

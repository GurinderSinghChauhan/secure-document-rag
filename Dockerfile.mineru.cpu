# Pipeline-only MinerU runtime for hosts without NVIDIA hardware or CUDA.
FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        fonts-noto-core \
        fonts-noto-cjk \
        fontconfig \
        libgl1 \
        libglib2.0-0 \
        libsm6 \
        libxext6 && \
    fc-cache -fv && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Install CPU-only PyTorch before MinerU resolves its dependencies. MinerU
# 3.2.1 expects the iterable page-character API removed in pdftext 0.7.
RUN python3 -m pip install --no-cache-dir \
        --index-url https://download.pytorch.org/whl/cpu \
        'torch==2.7.1' \
        'torchvision==0.22.1' && \
    python3 -m pip install --no-cache-dir \
        'mineru[core]==3.2.1' \
        'pdftext==0.6.3' && \
    python3 -m pip check

ENV MINERU_MODEL_SOURCE=local
ENTRYPOINT ["/bin/bash", "-c", "exec \"$@\"", "--"]
